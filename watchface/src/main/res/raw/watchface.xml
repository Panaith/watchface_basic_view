<WatchFace height="450" width="450">
    <Metadata key="CLOCK_TYPE" value="DIGITAL" />

    <UserConfigurations>
        <!-- Booleans -->
        <BooleanConfiguration id="showBattery" displayName="config_show_battery" defaultValue="TRUE" />
        <BooleanConfiguration id="showSeconds" displayName="config_show_seconds" defaultValue="TRUE" />
        
        <!-- Colors -->
        <ColorConfiguration id="bgColor" displayName="config_bg_color" defaultValue="0">
            <ColorOption id="0" displayName="opt_black" colors="#ff000000" />
            <ColorOption id="1" displayName="opt_dark_blue" colors="#ff000022" />
            <ColorOption id="2" displayName="opt_dark_red" colors="#ff220000" />
            <ColorOption id="3" displayName="opt_dark_green" colors="#ff002200" />
        </ColorConfiguration>
        <ColorConfiguration id="batteryColor" displayName="config_battery_color" defaultValue="0">
            <ColorOption id="0" displayName="opt_white" colors="#ffffffff" />
            <ColorOption id="1" displayName="opt_green" colors="#ffaaee00" />
            <ColorOption id="2" displayName="opt_orange" colors="#ffff7f00" />
        </ColorConfiguration>
        <ColorConfiguration id="fontsColor" displayName="config_fonts_color" defaultValue="0">
            <ColorOption id="0" displayName="opt_white" colors="#ffffffff" />
            <ColorOption id="1" displayName="opt_light_grey" colors="#ffdddddd" />
            <ColorOption id="2" displayName="opt_cyan" colors="#ff00ffff" />
        </ColorConfiguration>
        <ColorConfiguration id="accentColor" displayName="config_accent_color" defaultValue="0">
            <ColorOption id="0" displayName="opt_green" colors="#ffaaee00" />
            <ColorOption id="1" displayName="opt_white" colors="#ffffffff" />
            <ColorOption id="2" displayName="opt_orange" colors="#ffff7f00" />
            <ColorOption id="3" displayName="opt_blue" colors="#ff00aaff" />
        </ColorConfiguration>

        <!-- Lists -->
        <ListConfiguration id="clockWeight" displayName="config_clock_weight" defaultValue="1">
            <ListOption id="0" displayName="opt_normal" />
            <ListOption id="1" displayName="opt_bold" />
            <ListOption id="2" displayName="opt_light" />
        </ListConfiguration>
        <ListConfiguration id="clockFormat" displayName="config_clock_format" defaultValue="0">
            <ListOption id="0" displayName="opt_24_hour" />
            <ListOption id="1" displayName="opt_12_hour" />
        </ListConfiguration>
        <ListConfiguration id="bgPattern" displayName="config_bg_pattern" defaultValue="0">
            <ListOption id="0" displayName="opt_solid_color" />
            <ListOption id="1" displayName="opt_vignette" />
            <ListOption id="2" displayName="opt_grid" />
            <ListOption id="3" displayName="opt_circles" />
            <ListOption id="4" displayName="opt_diagonals" />
        </ListConfiguration>
    </UserConfigurations>

    <Scene>
        <!-- Background Solid Color -->
        <PartDraw x="0" y="0" width="450" height="450">
            <Rect x="0" y="0" width="450" height="450">
                <Fill color="[CONFIGURATION.bgColor]" />
            </Rect>
        </PartDraw>
        
        <!-- Background Vignette (Pattern 1) -->
        <Group x="0" y="0" width="450" height="450">
            <Transform target="alpha" value="[CONFIGURATION.bgPattern] == 1 ? 150 : 0" />
            <PartDraw x="0" y="0" width="450" height="450">
                <Rect x="0" y="0" width="450" height="450">
                    <Stroke color="#ff000000" thickness="80" />
                </Rect>
            </PartDraw>
        </Group>

        <!-- Grid Pattern (Pattern 2) -->
        <Group x="0" y="0" width="450" height="450">
            <Transform target="alpha" value="[CONFIGURATION.bgPattern] == 2 ? 30 : 0" />
            <PartDraw x="0" y="0" width="450" height="450">
                <Line startX="50" startY="0" endX="50" endY="450"> <Stroke color="#ffffffff" thickness="1"/> </Line>
                <Line startX="100" startY="0" endX="100" endY="450"> <Stroke color="#ffffffff" thickness="1"/> </Line>
                <Line startX="150" startY="0" endX="150" endY="450"> <Stroke color="#ffffffff" thickness="1"/> </Line>
                <Line startX="200" startY="0" endX="200" endY="450"> <Stroke color="#ffffffff" thickness="1"/> </Line>
                <Line startX="250" startY="0" endX="250" endY="450"> <Stroke color="#ffffffff" thickness="1"/> </Line>
                <Line startX="300" startY="0" endX="300" endY="450"> <Stroke color="#ffffffff" thickness="1"/> </Line>
                <Line startX="350" startY="0" endX="350" endY="450"> <Stroke color="#ffffffff" thickness="1"/> </Line>
                <Line startX="400" startY="0" endX="400" endY="450"> <Stroke color="#ffffffff" thickness="1"/> </Line>

                <Line startX="0" startY="50" endX="450" endY="50"> <Stroke color="#ffffffff" thickness="1"/> </Line>
                <Line startX="0" startY="100" endX="450" endY="100"> <Stroke color="#ffffffff" thickness="1"/> </Line>
                <Line startX="0" startY="150" endX="450" endY="150"> <Stroke color="#ffffffff" thickness="1"/> </Line>
                <Line startX="0" startY="200" endX="450" endY="200"> <Stroke color="#ffffffff" thickness="1"/> </Line>
                <Line startX="0" startY="250" endX="450" endY="250"> <Stroke color="#ffffffff" thickness="1"/> </Line>
                <Line startX="0" startY="300" endX="450" endY="300"> <Stroke color="#ffffffff" thickness="1"/> </Line>
                <Line startX="0" startY="350" endX="450" endY="350"> <Stroke color="#ffffffff" thickness="1"/> </Line>
                <Line startX="0" startY="400" endX="450" endY="400"> <Stroke color="#ffffffff" thickness="1"/> </Line>
            </PartDraw>
        </Group>

        <!-- Circles Pattern (Pattern 3) -->
        <Group x="0" y="0" width="450" height="450">
            <Transform target="alpha" value="[CONFIGURATION.bgPattern] == 3 ? 20 : 0" />
            <PartDraw x="0" y="0" width="450" height="450">
                <Ellipse x="175" y="175" width="100" height="100"> <Stroke color="#ffffffff" thickness="2"/> </Ellipse>
                <Ellipse x="125" y="125" width="200" height="200"> <Stroke color="#ffffffff" thickness="2"/> </Ellipse>
                <Ellipse x="75" y="75" width="300" height="300"> <Stroke color="#ffffffff" thickness="2"/> </Ellipse>
                <Ellipse x="25" y="25" width="400" height="400"> <Stroke color="#ffffffff" thickness="2"/> </Ellipse>
            </PartDraw>
        </Group>

        <!-- Diagonal Pattern (Pattern 4) -->
        <Group x="0" y="0" width="450" height="450">
            <Transform target="alpha" value="[CONFIGURATION.bgPattern] == 4 ? 20 : 0" />
            <PartDraw x="0" y="0" width="450" height="450">
                <Line startX="0" startY="0" endX="450" endY="450"> <Stroke color="#ffffffff" thickness="3"/> </Line>
                <Line startX="100" startY="-100" endX="550" endY="350"> <Stroke color="#ffffffff" thickness="3"/> </Line>
                <Line startX="200" startY="-200" endX="650" endY="250"> <Stroke color="#ffffffff" thickness="3"/> </Line>
                <Line startX="-100" startY="100" endX="350" endY="550"> <Stroke color="#ffffffff" thickness="3"/> </Line>
                <Line startX="-200" startY="200" endX="250" endY="650"> <Stroke color="#ffffffff" thickness="3"/> </Line>
                <Line startX="450" startY="0" endX="0" endY="450"> <Stroke color="#ffffffff" thickness="3"/> </Line>
                <Line startX="550" startY="100" endX="100" endY="550"> <Stroke color="#ffffffff" thickness="3"/> </Line>
                <Line startX="650" startY="200" endX="200" endY="650"> <Stroke color="#ffffffff" thickness="3"/> </Line>
                <Line startX="350" startY="-100" endX="-100" endY="350"> <Stroke color="#ffffffff" thickness="3"/> </Line>
                <Line startX="250" startY="-200" endX="-200" endY="250"> <Stroke color="#ffffffff" thickness="3"/> </Line>
            </PartDraw>
        </Group>

        <!-- Top Battery Widget -->
        <Group name="battery_widget" x="125" y="25" width="200" height="50">
            <Transform target="alpha" value="[CONFIGURATION.showBattery] ? 255 : 0" />
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Launch target="BATTERY_STATUS" />
            <!-- Background Bar -->
            <PartDraw x="76" y="5" width="48" height="6">
                <Line startX="0" startY="3" endX="48" endY="3">
                    <Stroke color="#ff333333" thickness="6" cap="ROUND" />
                </Line>
            </PartDraw>
            <!-- Foreground Progress Bar -->
            <Group name="battery_progress" x="76" y="5" width="48" height="6" pivotX="0" pivotY="0.5">
                <Transform target="scaleX" value="[BATTERY_PERCENT] / 100" />
                <PartDraw x="0" y="0" width="48" height="6">
                    <Line startX="0" startY="3" endX="48" endY="3">
                        <Stroke color="[CONFIGURATION.batteryColor]" thickness="6" cap="ROUND" />
                    </Line>
                </PartDraw>
            </Group>
            <!-- Battery Percentage -->
            <PartText x="0" y="15" width="200" height="35">
                <Text align="CENTER">
                    <Font family="SYNC_TO_DEVICE" size="20" color="[CONFIGURATION.fontsColor]" weight="BOLD">
                        <Template>
                            <![CDATA[%s%%]]><Parameter expression="[BATTERY_PERCENT]" />
                        </Template>
                    </Font>
                </Text>
            </PartText>
        </Group>

        <!-- Row 1: Left Complication (Date) -->
        <ComplicationSlot slotId="1" supportedTypes="SHORT_TEXT SMALL_IMAGE MONOCHROMATIC_IMAGE PHOTO_IMAGE EMPTY" x="40" y="85" width="170" height="60">
            <DefaultProviderPolicy defaultSystemProvider="DAY_OF_WEEK_AND_DATE" defaultSystemProviderType="SHORT_TEXT" />
            <BoundingBox x="0" y="0" width="170" height="60" />
            <Complication type="SHORT_TEXT">
                <Group x="0" y="0" width="450" height="450">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                <PartText x="0" y="15" width="170" height="30">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="26" color="[CONFIGURATION.fontsColor]" weight="BOLD">
                            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
                </Group>
            </Complication>
            <Complication type="SMALL_IMAGE">
                <Group x="0" y="0" width="450" height="450">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                <PartImage x="64" y="9" width="42" height="42"><Image resource="[COMPLICATION.SMALL_IMAGE]" /></PartImage>
                </Group>
            </Complication>
            <Complication type="MONOCHROMATIC_IMAGE">
                <Group x="0" y="0" width="450" height="450">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                <PartImage x="64" y="9" width="42" height="42" tintColor="[CONFIGURATION.fontsColor]"><Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" /></PartImage>
                </Group>
            </Complication>
            <Complication type="PHOTO_IMAGE">
                <Group x="0" y="0" width="450" height="450">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                <PartImage x="64" y="9" width="42" height="42"><Image resource="[COMPLICATION.PHOTO_IMAGE]" /></PartImage>
                </Group>
            </Complication>
        </ComplicationSlot>

        <!-- Row 1: Right Complication (Weather) -->
        <ComplicationSlot slotId="2" supportedTypes="SHORT_TEXT SMALL_IMAGE MONOCHROMATIC_IMAGE PHOTO_IMAGE EMPTY" x="240" y="85" width="170" height="60">
            <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="SHORT_TEXT" />
            <BoundingBox x="0" y="0" width="170" height="60" />
            <Complication type="SHORT_TEXT">
                <Group x="0" y="0" width="450" height="450">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                <PartImage x="45" y="15" width="30" height="30">
                    <Image resource="[COMPLICATION.ICON]" />
                </PartImage>
                <PartImage x="45" y="15" width="30" height="30" tintColor="[CONFIGURATION.fontsColor]">
                    <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
                </PartImage>
                <PartText x="85" y="15" width="85" height="30">
                    <Text align="START">
                        <Font family="SYNC_TO_DEVICE" size="26" color="[CONFIGURATION.fontsColor]" weight="BOLD">
                            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
                </Group>
            </Complication>
            <Complication type="SMALL_IMAGE">
                <Group x="0" y="0" width="450" height="450">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                <PartImage x="64" y="9" width="42" height="42"><Image resource="[COMPLICATION.SMALL_IMAGE]" /></PartImage>
                </Group>
            </Complication>
            <Complication type="MONOCHROMATIC_IMAGE">
                <Group x="0" y="0" width="450" height="450">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                <PartImage x="64" y="9" width="42" height="42" tintColor="[CONFIGURATION.fontsColor]"><Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" /></PartImage>
                </Group>
            </Complication>
            <Complication type="PHOTO_IMAGE">
                <Group x="0" y="0" width="450" height="450">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                <PartImage x="64" y="9" width="42" height="42"><Image resource="[COMPLICATION.PHOTO_IMAGE]" /></PartImage>
                </Group>
            </Complication>
        </ComplicationSlot>

        <!-- Row 2: Clock Display -->
        <Group name="clock_widget" x="0" y="145" width="450" height="120">
            <Launch target="ALARM" />
            
            <!-- 24 HOUR FORMAT ([CONFIGURATION.clockFormat] == 0) -->
            <Group x="0" y="0" width="450" height="120">
                <Transform target="alpha" value="[CONFIGURATION.clockFormat] == 0 ? 255 : 0" />
                
                <!-- Normal Weight -->
                <Group x="0" y="0" width="450" height="120">
                    <Transform target="alpha" value="[CONFIGURATION.clockWeight] == 0 ? 255 : 0" />
                    <DigitalClock x="0" y="0" width="450" height="120">
                        <TimeText format="hh:mm" hourFormat="24" x="0" y="0" width="450" height="120" align="CENTER">
                            <Font color="[CONFIGURATION.accentColor]" family="SYNC_TO_DEVICE" size="110" weight="NORMAL" />
                        </TimeText>
                    </DigitalClock>
                </Group>
                
                <!-- Bold Weight -->
                <Group x="0" y="0" width="450" height="120">
                    <Transform target="alpha" value="[CONFIGURATION.clockWeight] == 1 ? 255 : 0" />
                    <DigitalClock x="0" y="0" width="450" height="120">
                        <TimeText format="hh:mm" hourFormat="24" x="0" y="0" width="450" height="120" align="CENTER">
                            <Font color="[CONFIGURATION.accentColor]" family="SYNC_TO_DEVICE" size="110" weight="BOLD" />
                        </TimeText>
                    </DigitalClock>
                </Group>
                
                <!-- Light Weight -->
                <Group x="0" y="0" width="450" height="120">
                    <Transform target="alpha" value="[CONFIGURATION.clockWeight] == 2 ? 255 : 0" />
                    <DigitalClock x="0" y="0" width="450" height="120">
                        <TimeText format="hh:mm" hourFormat="24" x="0" y="0" width="450" height="120" align="CENTER">
                            <Font color="[CONFIGURATION.accentColor]" family="SYNC_TO_DEVICE" size="110" weight="LIGHT" />
                        </TimeText>
                    </DigitalClock>
                </Group>
            </Group>

            <!-- 12 HOUR FORMAT ([CONFIGURATION.clockFormat] == 1) -->
            <Group x="0" y="0" width="450" height="120">
                <Transform target="alpha" value="[CONFIGURATION.clockFormat] == 1 ? 255 : 0" />
                
                <!-- Normal Weight -->
                <Group x="0" y="0" width="450" height="120">
                    <Transform target="alpha" value="[CONFIGURATION.clockWeight] == 0 ? 255 : 0" />
                    <DigitalClock x="0" y="0" width="450" height="120">
                        <TimeText format="hh:mm" hourFormat="12" x="0" y="0" width="450" height="120" align="CENTER">
                            <Font color="[CONFIGURATION.accentColor]" family="SYNC_TO_DEVICE" size="110" weight="NORMAL" />
                        </TimeText>
                    </DigitalClock>
                </Group>
                
                <!-- Bold Weight -->
                <Group x="0" y="0" width="450" height="120">
                    <Transform target="alpha" value="[CONFIGURATION.clockWeight] == 1 ? 255 : 0" />
                    <DigitalClock x="0" y="0" width="450" height="120">
                        <TimeText format="hh:mm" hourFormat="12" x="0" y="0" width="450" height="120" align="CENTER">
                            <Font color="[CONFIGURATION.accentColor]" family="SYNC_TO_DEVICE" size="110" weight="BOLD" />
                        </TimeText>
                    </DigitalClock>
                </Group>
                
                <!-- Light Weight -->
                <Group x="0" y="0" width="450" height="120">
                    <Transform target="alpha" value="[CONFIGURATION.clockWeight] == 2 ? 255 : 0" />
                    <DigitalClock x="0" y="0" width="450" height="120">
                        <TimeText format="hh:mm" hourFormat="12" x="0" y="0" width="450" height="120" align="CENTER">
                            <Font color="[CONFIGURATION.accentColor]" family="SYNC_TO_DEVICE" size="110" weight="LIGHT" />
                        </TimeText>
                    </DigitalClock>
                </Group>
            </Group>

            <!-- Seconds Display (Toggled by showSeconds) -->
            <Group x="380" y="25" width="70" height="40">
                <Transform target="alpha" value="[CONFIGURATION.showSeconds] ? 255 : 0" />
                <Variant mode="AMBIENT" target="alpha" value="0" />
                
                <!-- Normal Weight -->
                <Group x="0" y="0" width="70" height="40">
                    <Transform target="alpha" value="[CONFIGURATION.clockWeight] == 0 ? 255 : 0" />
                    <DigitalClock x="0" y="0" width="70" height="40">
                        <TimeText format="ss" x="0" y="0" width="70" height="40" align="START">
                            <Font color="[CONFIGURATION.accentColor]" family="SYNC_TO_DEVICE" size="26" weight="NORMAL" />
                        </TimeText>
                    </DigitalClock>
                </Group>
                
                <!-- Bold Weight -->
                <Group x="0" y="0" width="70" height="40">
                    <Transform target="alpha" value="[CONFIGURATION.clockWeight] == 1 ? 255 : 0" />
                    <DigitalClock x="0" y="0" width="70" height="40">
                        <TimeText format="ss" x="0" y="0" width="70" height="40" align="START">
                            <Font color="[CONFIGURATION.accentColor]" family="SYNC_TO_DEVICE" size="26" weight="BOLD" />
                        </TimeText>
                    </DigitalClock>
                </Group>
                
                <!-- Light Weight -->
                <Group x="0" y="0" width="70" height="40">
                    <Transform target="alpha" value="[CONFIGURATION.clockWeight] == 2 ? 255 : 0" />
                    <DigitalClock x="0" y="0" width="70" height="40">
                        <TimeText format="ss" x="0" y="0" width="70" height="40" align="START">
                            <Font color="[CONFIGURATION.accentColor]" family="SYNC_TO_DEVICE" size="26" weight="LIGHT" />
                        </TimeText>
                    </DigitalClock>
                </Group>
            </Group>
        </Group>

        <!-- Row 3: Next Day Event Complication -->
        <ComplicationSlot slotId="3" supportedTypes="LONG_TEXT SHORT_TEXT SMALL_IMAGE MONOCHROMATIC_IMAGE PHOTO_IMAGE EMPTY" x="40" y="260" width="370" height="45">
            <DefaultProviderPolicy defaultSystemProvider="NEXT_EVENT" defaultSystemProviderType="LONG_TEXT" />
            <BoundingBox x="0" y="0" width="370" height="45" />
            <Complication type="LONG_TEXT">
                <Group x="0" y="0" width="450" height="450">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                <PartText x="0" y="0" width="370" height="18">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="14" color="[CONFIGURATION.fontsColor]" weight="NORMAL">
                            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TITLE]" /></Template>
                        </Font>
                    </Text>
                </PartText>
                <PartText x="0" y="18" width="370" height="27">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="20" color="[CONFIGURATION.fontsColor]" weight="BOLD">
                            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
                </Group>
            </Complication>
            <Complication type="SHORT_TEXT">
                <Group x="0" y="0" width="450" height="450">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                <PartText x="0" y="0" width="370" height="18">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="14" color="[CONFIGURATION.fontsColor]" weight="NORMAL">
                            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TITLE]" /></Template>
                        </Font>
                    </Text>
                </PartText>
                <PartText x="0" y="18" width="370" height="27">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="20" color="[CONFIGURATION.fontsColor]" weight="BOLD">
                            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
                </Group>
            </Complication>
            <Complication type="SMALL_IMAGE">
                <Group x="0" y="0" width="450" height="450">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                <PartImage x="164" y="1" width="42" height="42"><Image resource="[COMPLICATION.SMALL_IMAGE]" /></PartImage>
                </Group>
            </Complication>
            <Complication type="MONOCHROMATIC_IMAGE">
                <Group x="0" y="0" width="450" height="450">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                <PartImage x="164" y="1" width="42" height="42" tintColor="[CONFIGURATION.fontsColor]"><Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" /></PartImage>
                </Group>
            </Complication>
            <Complication type="PHOTO_IMAGE">
                <Group x="0" y="0" width="450" height="450">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                <PartImage x="164" y="1" width="42" height="42"><Image resource="[COMPLICATION.PHOTO_IMAGE]" /></PartImage>
                </Group>
            </Complication>
        </ComplicationSlot>

        <!-- Bottom: App Shortcuts (5 Complications in an arc) -->
        <ComplicationSlot slotId="4" supportedTypes="MONOCHROMATIC_IMAGE SMALL_IMAGE PHOTO_IMAGE EMPTY" x="78" y="310" width="42" height="42">
            <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="SMALL_IMAGE" />
            <BoundingOval x="0" y="0" width="42" height="42" />
            <Complication type="MONOCHROMATIC_IMAGE">
                <Group x="0" y="0" width="450" height="450">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                <PartImage x="0" y="0" width="42" height="42" tintColor="[CONFIGURATION.fontsColor]"><Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" /></PartImage>
                </Group>
            </Complication>
            <Complication type="SMALL_IMAGE">
                <Group x="0" y="0" width="450" height="450">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                <PartImage x="0" y="0" width="42" height="42"><Image resource="[COMPLICATION.SMALL_IMAGE]" /></PartImage>
                </Group>
            </Complication>
            <Complication type="PHOTO_IMAGE">
                <Group x="0" y="0" width="450" height="450">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                <PartImage x="0" y="0" width="42" height="42"><Image resource="[COMPLICATION.PHOTO_IMAGE]" /></PartImage>
                </Group>
            </Complication>
        </ComplicationSlot>

        <ComplicationSlot slotId="5" supportedTypes="MONOCHROMATIC_IMAGE SMALL_IMAGE PHOTO_IMAGE EMPTY" x="140" y="330" width="42" height="42">
            <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="SMALL_IMAGE" />
            <BoundingOval x="0" y="0" width="42" height="42" />
            <Complication type="MONOCHROMATIC_IMAGE">
                <Group x="0" y="0" width="450" height="450">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                <PartImage x="0" y="0" width="42" height="42" tintColor="[CONFIGURATION.fontsColor]"><Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" /></PartImage>
                </Group>
            </Complication>
            <Complication type="SMALL_IMAGE">
                <Group x="0" y="0" width="450" height="450">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                <PartImage x="0" y="0" width="42" height="42"><Image resource="[COMPLICATION.SMALL_IMAGE]" /></PartImage>
                </Group>
            </Complication>
            <Complication type="PHOTO_IMAGE">
