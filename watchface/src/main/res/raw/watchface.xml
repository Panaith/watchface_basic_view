<WatchFace
    height="450"
    width="450">
    <Metadata
        key="CLOCK_TYPE"
        value="DIGITAL" />

    <UserConfigurations>
        <ColorConfiguration id="timeColor" displayName="time_color" defaultValue="0">
            <ColorOption id="0" displayName="color_white" colors="#ffffffff" />
            <ColorOption id="1" displayName="color_orange" colors="#ffff7f00" />
            <ColorOption id="2" displayName="color_blue" colors="#ff00aaff" />
            <ColorOption id="3" displayName="color_green" colors="#ffaaee00" />
        </ColorConfiguration>
    </UserConfigurations>

    <Scene>
        <!-- Top Battery Widget -->
        <Group name="battery_widget" x="125" y="25" width="200" height="50">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Launch target="BATTERY_STATUS" />
            <!-- Background Bar -->
            <PartDraw x="76" y="5" width="48" height="6">
                <Line startX="0" startY="3" endX="48" endY="3">
                    <Stroke color="#ff333333" thickness="6" cap="ROUND" />
                </Line>
            </PartDraw>
            <!-- Foreground Progress Bar -->
            <Group name="battery_progress" x="76" y="5" width="48" height="6" pivotX="0" pivotY="0.5">
                <Transform target="scaleX" value="[BATTERY_PERCENT] / 100" />
                <PartDraw x="0" y="0" width="48" height="6">
                    <Line startX="0" startY="3" endX="48" endY="3">
                        <Stroke color="[CONFIGURATION.timeColor]" thickness="6" cap="ROUND" />
                    </Line>
                </PartDraw>
            </Group>
            <!-- Battery Percentage -->
            <PartText x="0" y="15" width="200" height="35">
                <Text align="CENTER">
                    <Font family="SYNC_TO_DEVICE" size="20" color="#ffdddddd" weight="BOLD">
                        <Template>
                            <![CDATA[%s%%]]><Parameter expression="[BATTERY_PERCENT]" />
                        </Template>
                    </Font>
                </Text>
            </PartText>
        </Group>

        <!-- Row 1: Left Complication (Date) -->
        <ComplicationSlot slotId="1" supportedTypes="SHORT_TEXT SMALL_IMAGE MONOCHROMATIC_IMAGE PHOTO_IMAGE EMPTY" x="70" y="85" width="140" height="60">
            <DefaultProviderPolicy defaultSystemProvider="DAY_OF_WEEK_AND_DATE" defaultSystemProviderType="SHORT_TEXT" />
            <BoundingBox x="0" y="0" width="140" height="60" />
            <Complication type="SHORT_TEXT">
                <Group x="0" y="0" width="450" height="450">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                <PartText x="0" y="15" width="140" height="30">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="22" color="#ffffffff" weight="BOLD">
                            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
                </Group>
            </Complication>
            <Complication type="SMALL_IMAGE">
                <Group x="0" y="0" width="450" height="450">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                <PartImage x="49" y="9" width="42" height="42"><Image resource="[COMPLICATION.SMALL_IMAGE]" /></PartImage>
                </Group>
            </Complication>
            <Complication type="MONOCHROMATIC_IMAGE">
                <Group x="0" y="0" width="450" height="450">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                <PartImage x="49" y="9" width="42" height="42" tintColor="#ffffffff"><Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" /></PartImage>
                </Group>
            </Complication>
            <Complication type="PHOTO_IMAGE">
                <Group x="0" y="0" width="450" height="450">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                <PartImage x="49" y="9" width="42" height="42"><Image resource="[COMPLICATION.PHOTO_IMAGE]" /></PartImage>
                </Group>
            </Complication>
        </ComplicationSlot>

        <!-- Row 1: Right Complication (Weather) -->
        <ComplicationSlot slotId="2" supportedTypes="SHORT_TEXT SMALL_IMAGE MONOCHROMATIC_IMAGE PHOTO_IMAGE EMPTY" x="240" y="85" width="140" height="60">
            <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="SHORT_TEXT" />
            <BoundingBox x="0" y="0" width="140" height="60" />
            <Complication type="SHORT_TEXT">
                <Group x="0" y="0" width="450" height="450">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                <PartImage x="35" y="15" width="30" height="30">
                    <Image resource="[COMPLICATION.ICON]" />
                </PartImage>
                <PartImage x="35" y="15" width="30" height="30" tintColor="#ffffffff">
                    <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
                </PartImage>
                <PartText x="70" y="15" width="70" height="30">
                    <Text align="START">
                        <Font family="SYNC_TO_DEVICE" size="24" color="#ffffffff" weight="BOLD">
                            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
                </Group>
            </Complication>
            <Complication type="SMALL_IMAGE">
                <Group x="0" y="0" width="450" height="450">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                <PartImage x="49" y="9" width="42" height="42"><Image resource="[COMPLICATION.SMALL_IMAGE]" /></PartImage>
                </Group>
            </Complication>
            <Complication type="MONOCHROMATIC_IMAGE">
                <Group x="0" y="0" width="450" height="450">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                <PartImage x="49" y="9" width="42" height="42" tintColor="#ffffffff"><Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" /></PartImage>
                </Group>
            </Complication>
            <Complication type="PHOTO_IMAGE">
                <Group x="0" y="0" width="450" height="450">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                <PartImage x="49" y="9" width="42" height="42"><Image resource="[COMPLICATION.PHOTO_IMAGE]" /></PartImage>
                </Group>
            </Complication>
        </ComplicationSlot>

        <!-- Row 2: Clock Display -->
        <Group name="clock_widget" x="0" y="145" width="450" height="120">
            <Launch target="ALARM" />
            <DigitalClock x="0" y="0" width="450" height="120">
                <!-- Interactive Mode -->
                <TimeText format="hh:mm" x="0" y="0" width="450" height="120" align="CENTER">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Font color="[CONFIGURATION.timeColor]" family="SYNC_TO_DEVICE" size="110" weight="BOLD" />
                </TimeText>
                <TimeText format="ss" x="380" y="25" width="70" height="40" align="START">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Font color="[CONFIGURATION.timeColor]" family="SYNC_TO_DEVICE" size="26" weight="BOLD" />
                </TimeText>
                <!-- Ambient Mode -->
                <TimeText format="hh:mm" alpha="0" x="0" y="0" width="450" height="120" align="CENTER">
                    <Variant mode="AMBIENT" target="alpha" value="255" />
                    <Font color="[CONFIGURATION.timeColor]" family="SYNC_TO_DEVICE" size="110" weight="BOLD" />
                </TimeText>
            </DigitalClock>
        </Group>

        <!-- Row 3: Next Day Event Complication -->
        <ComplicationSlot slotId="3" supportedTypes="LONG_TEXT SHORT_TEXT SMALL_IMAGE MONOCHROMATIC_IMAGE PHOTO_IMAGE EMPTY" x="40" y="260" width="370" height="45">
            <DefaultProviderPolicy defaultSystemProvider="NEXT_EVENT" defaultSystemProviderType="LONG_TEXT" />
            <BoundingBox x="0" y="0" width="370" height="45" />
            <Complication type="LONG_TEXT">
                <Group x="0" y="0" width="450" height="450">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                <PartText x="0" y="0" width="370" height="18">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="14" color="#ffaaaaaa" weight="NORMAL">
                            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TITLE]" /></Template>
                        </Font>
                    </Text>
                </PartText>
                <PartText x="0" y="18" width="370" height="27">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="20" color="#ffffffff" weight="BOLD">
                            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
                </Group>
            </Complication>
            <Complication type="SHORT_TEXT">
                <Group x="0" y="0" width="450" height="450">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                <PartText x="0" y="0" width="370" height="18">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="14" color="#ffaaaaaa" weight="NORMAL">
                            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TITLE]" /></Template>
                        </Font>
                    </Text>
                </PartText>
                <PartText x="0" y="18" width="370" height="27">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="20" color="#ffffffff" weight="BOLD">
                            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
                </Group>
            </Complication>
            <Complication type="SMALL_IMAGE">
                <Group x="0" y="0" width="450" height="450">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                <PartImage x="164" y="1" width="42" height="42"><Image resource="[COMPLICATION.SMALL_IMAGE]" /></PartImage>
                </Group>
            </Complication>
            <Complication type="MONOCHROMATIC_IMAGE">
                <Group x="0" y="0" width="450" height="450">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                <PartImage x="164" y="1" width="42" height="42" tintColor="#ffffffff"><Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" /></PartImage>
                </Group>
            </Complication>
            <Complication type="PHOTO_IMAGE">
                <Group x="0" y="0" width="450" height="450">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                <PartImage x="164" y="1" width="42" height="42"><Image resource="[COMPLICATION.PHOTO_IMAGE]" /></PartImage>
                </Group>
            </Complication>
        </ComplicationSlot>

        <!-- Bottom: App Shortcuts (5 Complications in an arc) -->
        <ComplicationSlot slotId="4" supportedTypes="MONOCHROMATIC_IMAGE SMALL_IMAGE PHOTO_IMAGE EMPTY" x="78" y="310" width="42" height="42">
            <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="SMALL_IMAGE" />
            <BoundingOval x="0" y="0" width="42" height="42" />
            <Complication type="MONOCHROMATIC_IMAGE">
                <Group x="0" y="0" width="450" height="450">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                <PartImage x="0" y="0" width="42" height="42" tintColor="#ffffffff"><Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" /></PartImage>
                </Group>
            </Complication>
            <Complication type="SMALL_IMAGE">
                <Group x="0" y="0" width="450" height="450">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                <PartImage x="0" y="0" width="42" height="42"><Image resource="[COMPLICATION.SMALL_IMAGE]" /></PartImage>
                </Group>
            </Complication>
            <Complication type="PHOTO_IMAGE">
                <Group x="0" y="0" width="450" height="450">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                <PartImage x="0" y="0" width="42" height="42"><Image resource="[COMPLICATION.PHOTO_IMAGE]" /></PartImage>
                </Group>
            </Complication>
        </ComplicationSlot>

        <ComplicationSlot slotId="5" supportedTypes="MONOCHROMATIC_IMAGE SMALL_IMAGE PHOTO_IMAGE EMPTY" x="140" y="330" width="42" height="42">
            <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="SMALL_IMAGE" />
            <BoundingOval x="0" y="0" width="42" height="42" />
            <Complication type="MONOCHROMATIC_IMAGE">
                <Group x="0" y="0" width="450" height="450">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                <PartImage x="0" y="0" width="42" height="42" tintColor="#ffffffff"><Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" /></PartImage>
                </Group>
            </Complication>
            <Complication type="SMALL_IMAGE">
                <Group x="0" y="0" width="450" height="450">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                <PartImage x="0" y="0" width="42" height="42"><Image resource="[COMPLICATION.SMALL_IMAGE]" /></PartImage>
                </Group>
            </Complication>
            <Complication type="PHOTO_IMAGE">
                <Group x="0" y="0" width="450" height="450">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                <PartImage x="0" y="0" width="42" height="42"><Image resource="[COMPLICATION.PHOTO_IMAGE]" /></PartImage>
                </Group>
            </Complication>
        </ComplicationSlot>

        <ComplicationSlot slotId="6" supportedTypes="MONOCHROMATIC_IMAGE SMALL_IMAGE PHOTO_IMAGE EMPTY" x="204" y="340" width="42" height="42">
            <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="SMALL_IMAGE" />
            <BoundingOval x="0" y="0" width="42" height="42" />
            <Complication type="MONOCHROMATIC_IMAGE">
                <Group x="0" y="0" width="450" height="450">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                <PartImage x="0" y="0" width="42" height="42" tintColor="#ffffffff"><Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" /></PartImage>
                </Group>
            </Complication>
            <Complication type="SMALL_IMAGE">
                <Group x="0" y="0" width="450" height="450">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                <PartImage x="0" y="0" width="42" height="42"><Image resource="[COMPLICATION.SMALL_IMAGE]" /></PartImage>
                </Group>
            </Complication>
            <Complication type="PHOTO_IMAGE">
                <Group x="0" y="0" width="450" height="450">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                <PartImage x="0" y="0" width="42" height="42"><Image resource="[COMPLICATION.PHOTO_IMAGE]" /></PartImage>
                </Group>
            </Complication>
        </ComplicationSlot>

        <ComplicationSlot slotId="7" supportedTypes="MONOCHROMATIC_IMAGE SMALL_IMAGE PHOTO_IMAGE EMPTY" x="268" y="330" width="42" height="42">
            <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="SMALL_IMAGE" />
            <BoundingOval x="0" y="0" width="42" height="42" />
            <Complication type="MONOCHROMATIC_IMAGE">
                <Group x="0" y="0" width="450" height="450">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                <PartImage x="0" y="0" width="42" height="42" tintColor="#ffffffff"><Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" /></PartImage>
                </Group>
            </Complication>
            <Complication type="SMALL_IMAGE">
                <Group x="0" y="0" width="450" height="450">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                <PartImage x="0" y="0" width="42" height="42"><Image resource="[COMPLICATION.SMALL_IMAGE]" /></PartImage>
                </Group>
            </Complication>
            <Complication type="PHOTO_IMAGE">
                <Group x="0" y="0" width="450" height="450">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                <PartImage x="0" y="0" width="42" height="42"><Image resource="[COMPLICATION.PHOTO_IMAGE]" /></PartImage>
                </Group>
            </Complication>
        </ComplicationSlot>

        <ComplicationSlot slotId="8" supportedTypes="MONOCHROMATIC_IMAGE SMALL_IMAGE PHOTO_IMAGE EMPTY" x="330" y="310" width="42" height="42">
            <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="SMALL_IMAGE" />
            <BoundingOval x="0" y="0" width="42" height="42" />
            <Complication type="MONOCHROMATIC_IMAGE">
                <Group x="0" y="0" width="450" height="450">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                <PartImage x="0" y="0" width="42" height="42" tintColor="#ffffffff"><Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" /></PartImage>
                </Group>
            </Complication>
            <Complication type="SMALL_IMAGE">
                <Group x="0" y="0" width="450" height="450">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                <PartImage x="0" y="0" width="42" height="42"><Image resource="[COMPLICATION.SMALL_IMAGE]" /></PartImage>
                </Group>
            </Complication>
            <Complication type="PHOTO_IMAGE">
                <Group x="0" y="0" width="450" height="450">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                <PartImage x="0" y="0" width="42" height="42"><Image resource="[COMPLICATION.PHOTO_IMAGE]" /></PartImage>
                </Group>
            </Complication>
        </ComplicationSlot>

        <!-- Custom Logo -->
        <Group name="logo_widget" x="0" y="400" width="450" height="35">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Launch target="com.google.android.contacts" />
            <PartText x="0" y="0" width="450" height="35">
                <Text align="CENTER">
                    <Font family="corinthia" size="28" color="#ffcccccc">PanSar</Font>
                </Text>
            </PartText>
        </Group>
    </Scene>
</WatchFace>