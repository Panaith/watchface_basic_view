<?xml version="1.0" encoding="utf-8"?>
<WatchFace width="450" height="450" clipShape="CIRCLE">
    <Metadata key="CLOCK_TYPE" value="DIGITAL"/>

    <UserConfigurations>
        <ColorConfiguration id="themeColor" defaultValue="0" displayName="config_theme_color" screenReaderText="config_theme_color">
            <ColorOption id="0" colors="#ff000000 #ffffffff #ffffffff" displayName="opt_bg_color_white" screenReaderText="opt_bg_color_white"/>
            <ColorOption id="1" colors="#ff000000 #ff33ccff #ff33ccff" displayName="opt_bg_color_cyan" screenReaderText="opt_bg_color_cyan"/>
            <ColorOption id="2" colors="#ff000000 #fff08000 #fff08000" displayName="opt_bg_color_orange" screenReaderText="opt_bg_color_orange"/>
            <ColorOption id="3" colors="#ff000000 #ff00ff00 #ff00ff00" displayName="opt_bg_color_green" screenReaderText="opt_bg_color_green"/>
            <ColorOption id="4" colors="#ff000000 #ff8a2be2 #ff8a2be2" displayName="opt_bg_color_blue" screenReaderText="opt_bg_color_blue"/>
            <ColorOption id="5" colors="#ff000000 #ffff2400 #ffff2400" displayName="opt_bg_color_dark_red" screenReaderText="opt_bg_color_dark_red"/>
            <ColorOption id="6" colors="#ff000000 #ff33ccff #ffffffff" displayName="opt_bg_color_cyan" screenReaderText="opt_bg_color_cyan"/>
            <ColorOption id="7" colors="#ff000000 #fff08000 #ffffffff" displayName="opt_bg_color_orange" screenReaderText="opt_bg_color_orange"/>
            <ColorOption id="8" colors="#ff000000 #ff00ff00 #ffffffff" displayName="opt_bg_color_green" screenReaderText="opt_bg_color_green"/>
            <ColorOption id="9" colors="#ff000000 #ff8a2be2 #ffffffff" displayName="opt_bg_color_blue" screenReaderText="opt_bg_color_blue"/>
            <ColorOption id="10" colors="#ff000000 #ffff2400 #ffffffff" displayName="opt_bg_color_dark_red" screenReaderText="opt_bg_color_dark_red"/>
        </ColorConfiguration>
        <ListConfiguration id="bgImage" displayName="config_bg_image" screenReaderText="config_bg_image" defaultValue="0">
            <ListOption id="0" displayName="opt_solid_color" screenReaderText="opt_solid_color"/>
            <ListOption id="1" displayName="opt_solid_color" screenReaderText="opt_solid_color"/>
            <ListOption id="2" displayName="opt_solid_color" screenReaderText="opt_solid_color"/>
            <ListOption id="3" displayName="opt_solid_color" screenReaderText="opt_solid_color"/>
            <ListOption id="4" displayName="opt_solid_color" screenReaderText="opt_solid_color"/>
            <ListOption id="5" displayName="opt_solid_color" screenReaderText="opt_solid_color"/>
            <ListOption id="6" displayName="opt_solid_color" screenReaderText="opt_solid_color"/>
            <ListOption id="7" displayName="opt_solid_color" screenReaderText="opt_solid_color"/>
            <ListOption id="8" displayName="opt_solid_color" screenReaderText="opt_solid_color"/>
        </ListConfiguration>
        <ListConfiguration id="clockFormat" displayName="config_clock_format" screenReaderText="config_clock_format" defaultValue="0">
            <ListOption id="0" displayName="opt_clock_format_24_hour" screenReaderText="opt_clock_format_24_hour"/>
            <ListOption id="1" displayName="opt_clock_format_12_hour" screenReaderText="opt_clock_format_12_hour"/>
        </ListConfiguration>
        <ListConfiguration id="clockWeight" displayName="config_clock_weight" screenReaderText="config_clock_weight" defaultValue="0">
            <ListOption id="0" displayName="opt_clock_weight_normal" screenReaderText="opt_clock_weight_normal"/>
            <ListOption id="1" displayName="opt_clock_weight_bold" screenReaderText="opt_clock_weight_bold"/>
            <ListOption id="2" displayName="opt_clock_weight_light" screenReaderText="opt_clock_weight_light"/>
        </ListConfiguration>
        <BooleanConfiguration id="showSeconds" displayName="config_clock_show_seconds" screenReaderText="config_clock_show_seconds" defaultValue="TRUE"/>
        <BooleanConfiguration id="showBattery" displayName="config_show_battery_bar" screenReaderText="config_show_battery_bar" defaultValue="TRUE"/>
        <Flavors defaultValue="1">
            <Flavor id="1" displayName="flavor_default" screenReaderText="flavor_default">
                <Configuration id="themeColor" optionId="0"/>
                <Configuration id="bgImage" optionId="0"/>
                <ComplicationSlot slotId="2">
                    <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="SHORT_TEXT"/>
                </ComplicationSlot>
                <ComplicationSlot slotId="3">
                    <DefaultProviderPolicy defaultSystemProvider="NEXT_EVENT" defaultSystemProviderType="LONG_TEXT"/>
                </ComplicationSlot>
                <ComplicationSlot slotId="4">
                    <DefaultProviderPolicy defaultSystemProvider="APP_SHORTCUT" defaultSystemProviderType="SMALL_IMAGE"/>
                </ComplicationSlot>
                <ComplicationSlot slotId="5">
                    <DefaultProviderPolicy defaultSystemProvider="APP_SHORTCUT" defaultSystemProviderType="SMALL_IMAGE"/>
                </ComplicationSlot>
                <ComplicationSlot slotId="6">
                    <DefaultProviderPolicy defaultSystemProvider="APP_SHORTCUT" defaultSystemProviderType="SMALL_IMAGE"/>
                </ComplicationSlot>
                <ComplicationSlot slotId="7">
                    <DefaultProviderPolicy defaultSystemProvider="APP_SHORTCUT" defaultSystemProviderType="SMALL_IMAGE"/>
                </ComplicationSlot>
                <ComplicationSlot slotId="8">
                    <DefaultProviderPolicy defaultSystemProvider="APP_SHORTCUT" defaultSystemProviderType="SMALL_IMAGE"/>
                </ComplicationSlot>
            </Flavor>
            <Flavor id="2" displayName="flavor_variant" screenReaderText="flavor_variant">
                <Configuration id="themeColor" optionId="7"/>
                <Configuration id="bgImage" optionId="7"/>
                <ComplicationSlot slotId="2">
                    <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="SHORT_TEXT"/>
                </ComplicationSlot>
                <ComplicationSlot slotId="3">
                    <DefaultProviderPolicy defaultSystemProvider="NEXT_EVENT" defaultSystemProviderType="LONG_TEXT"/>
                </ComplicationSlot>
                <ComplicationSlot slotId="4">
                    <DefaultProviderPolicy defaultSystemProvider="APP_SHORTCUT" defaultSystemProviderType="SMALL_IMAGE"/>
                </ComplicationSlot>
                <ComplicationSlot slotId="5">
                    <DefaultProviderPolicy defaultSystemProvider="APP_SHORTCUT" defaultSystemProviderType="SMALL_IMAGE"/>
                </ComplicationSlot>
                <ComplicationSlot slotId="6">
                    <DefaultProviderPolicy defaultSystemProvider="APP_SHORTCUT" defaultSystemProviderType="SMALL_IMAGE"/>
                </ComplicationSlot>
                <ComplicationSlot slotId="7">
                    <DefaultProviderPolicy defaultSystemProvider="APP_SHORTCUT" defaultSystemProviderType="SMALL_IMAGE"/>
                </ComplicationSlot>
                <ComplicationSlot slotId="8">
                    <DefaultProviderPolicy defaultSystemProvider="APP_SHORTCUT" defaultSystemProviderType="SMALL_IMAGE"/>
                </ComplicationSlot>
            </Flavor>
        </Flavors>
    </UserConfigurations>

    <Scene backgroundColor="#ff000000">
        <!-- Background Solid Tint -->
        <PartDraw x="0" y="0" width="450" height="450" name="bg_solid" tintColor="[CONFIGURATION.themeColor.0]" alpha="255">
            <Variant mode="AMBIENT" target="alpha" value="0"/>
            <Rectangle x="0" y="0" width="450" height="450">
                <Fill color="#ff888888"/>
            </Rectangle>
        </PartDraw>
        
        <!-- Background Image -->
        <Group x="0" y="0" width="450" height="450" name="bg_image_group" alpha="255">
            <Variant mode="AMBIENT" target="alpha" value="0"/>
            <ListConfiguration id="bgImage">
                <ListOption id="0">
                    <PartImage x="0" y="0" width="450" height="450" name="bg_image_0"><Image resource="background_1"/></PartImage>
                </ListOption>
                <ListOption id="1">
                    <PartImage x="0" y="0" width="450" height="450" name="bg_image_1"><Image resource="background_2"/></PartImage>
                </ListOption>
                <ListOption id="2">
                    <PartImage x="0" y="0" width="450" height="450" name="bg_image_2"><Image resource="background_3"/></PartImage>
                </ListOption>
                <ListOption id="3">
                    <PartImage x="0" y="0" width="450" height="450" name="bg_image_3"><Image resource="background_4"/></PartImage>
                </ListOption>
                <ListOption id="4">
                    <PartImage x="0" y="0" width="450" height="450" name="bg_image_4"><Image resource="background_5"/></PartImage>
                </ListOption>
                <ListOption id="5">
                    <PartImage x="0" y="0" width="450" height="450" name="bg_image_5"><Image resource="background_6"/></PartImage>
                </ListOption>
                <ListOption id="6">
                    <PartImage x="0" y="0" width="450" height="450" name="bg_image_6"><Image resource="background_7"/></PartImage>
                </ListOption>
                <ListOption id="7">
                    <PartImage x="0" y="0" width="450" height="450" name="bg_image_7"><Image resource="background_8"/></PartImage>
                </ListOption>
                <ListOption id="8">
                    <PartImage x="0" y="0" width="450" height="450" name="bg_image_8"><Image resource="background_9"/></PartImage>
                </ListOption>
            </ListConfiguration>
        </Group>

        <!-- Top Battery Widget -->
        <Group name="battery_widget" x="125" y="25" width="200" height="50">
            <Variant mode="AMBIENT" target="alpha" value="0"/>
            <Launch target="BATTERY_STATUS"/>
            
            <!-- Battery Bar (Toggled by showBattery) -->
            <Group name="battery_bar_group" x="0" y="0" width="200" height="50">
                <Transform target="alpha" value="[CONFIGURATION.showBattery] ? 255 : 0"/>
                <!-- Low Battery (< 10%) -->
                <Condition>
                    <Expressions>
                        <Expression name="isLowBattery"><![CDATA[[BATTERY_PERCENT] >= 0 && [BATTERY_PERCENT] <= 9]]></Expression>
                    </Expressions>
                    <Compare expression="isLowBattery">
                        <PartDraw x="76" y="5" width="48" height="6" name="battery_bar_low">
                            <Line startX="0" startY="3" endX="48" endY="3">
                                <Stroke color="#80ff0101" thickness="6" cap="ROUND"/>
                            </Line>
                            <Line startX="0" startY="3" endX="0" endY="3">
                                <Transform target="endX" value="(((clamp([BATTERY_PERCENT], 0, 100)) / 100) * 48)"/>
                                <Stroke color="#ffff0101" thickness="6" cap="ROUND"/>
                            </Line>
                        </PartDraw>
                    </Compare>
                </Condition>
                <!-- Normal Battery (>= 10%) -->
                <Condition>
                    <Expressions>
                        <Expression name="isNormalBattery"><![CDATA[[BATTERY_PERCENT] >= 10 && [BATTERY_PERCENT] <= 100]]></Expression>
                    </Expressions>
                    <Compare expression="isNormalBattery">
                        <PartDraw x="76" y="5" width="48" height="6" name="battery_bar_normal" tintColor="[CONFIGURATION.themeColor.1]">
                            <Line startX="0" startY="3" endX="48" endY="3">
                                <Stroke color="#80ffffff" thickness="6" cap="ROUND"/>
                            </Line>
                            <Line startX="0" startY="3" endX="0" endY="3">
                                <Transform target="endX" value="(((clamp([BATTERY_PERCENT], 0, 100)) / 100) * 48)"/>
                                <Stroke color="#ffffffff" thickness="6" cap="ROUND"/>
                            </Line>
                        </PartDraw>
                    </Compare>
                </Condition>
            </Group>

            <!-- Battery Percentage -->
            <PartText x="0" y="15" width="200" height="35" name="battery_text">
                <Text align="CENTER">
                    <Font family="SYNC_TO_DEVICE" size="20" color="[CONFIGURATION.themeColor.2]" weight="BOLD">
                        <Template><![CDATA[%s%%]]><Parameter expression="[BATTERY_PERCENT]"/></Template>
                    </Font>
                </Text>
            </PartText>
        </Group>

        <!-- Static Date Display (matching watchface_total_view) -->
        <PartText x="30" y="85" width="190" height="60" name="Date_Display" alpha="255">
            <Launch target="CALENDAR"/>
            <Localization calendar="GREGORIAN"/>
            <Text align="CENTER" ellipsis="TRUE">
                <Font family="SYNC_TO_DEVICE" size="20" color="[CONFIGURATION.themeColor.2]" weight="BOLD">
                    <Template><![CDATA[%s, %s %s %s]]><Parameter expression="[DAY_OF_WEEK_S]"/><Parameter expression="[DAY]"/><Parameter expression="[MONTH_S]"/><Parameter expression="[YEAR]"/></Template>
                </Font>
            </Text>
        </PartText>

        <!-- Row 1: Right Complication (Weather) -->
        <ComplicationSlot slotId="2" displayName="Weather" isCustomizable="TRUE" supportedTypes="SHORT_TEXT SMALL_IMAGE MONOCHROMATIC_IMAGE PHOTO_IMAGE EMPTY" x="240" y="85" width="170" height="60" name="Slot2_Weather" alpha="255">
            <Variant mode="AMBIENT" target="alpha" value="0"/>
            <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="SHORT_TEXT"/>
            <BoundingBox x="0" y="0" width="170" height="60"/>
            <Complication type="SHORT_TEXT">
                <Condition>
                    <Expressions>
                        <Expression name="hasIcon"><![CDATA[[COMPLICATION.ICON] != null]]></Expression>
                        <Expression name="hasMono"><![CDATA[[COMPLICATION.ICON] == null && [COMPLICATION.MONOCHROMATIC_IMAGE] != null]]></Expression>
                    </Expressions>
                    <Compare expression="hasIcon">
                        <PartImage x="45" y="15" width="30" height="30" name="Weather_Icon" alpha="255">
                            <Image resource="[COMPLICATION.ICON]"/>
                        </PartImage>
                    </Compare>
                    <Compare expression="hasMono">
                        <PartImage x="45" y="15" width="30" height="30" name="Weather_MonoIcon" tintColor="[CONFIGURATION.themeColor.1]" alpha="255">
                            <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]"/>
                        </PartImage>
                    </Compare>
                </Condition>
                <PartText x="85" y="15" width="85" height="30" name="Weather_Text" alpha="255">
                    <Text align="START" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="26" color="[CONFIGURATION.themeColor.2]" weight="BOLD">
                            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]"/></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="SMALL_IMAGE">
                <PartImage x="64" y="9" width="42" height="42" name="Weather_SmallImage"><Image resource="[COMPLICATION.SMALL_IMAGE]"/></PartImage>
            </Complication>
            <Complication type="MONOCHROMATIC_IMAGE">
                <PartImage x="64" y="9" width="42" height="42" name="Weather_MonoImage" tintColor="[CONFIGURATION.themeColor.1]"><Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]"/></PartImage>
            </Complication>
            <Complication type="PHOTO_IMAGE">
                <PartImage x="64" y="9" width="42" height="42" name="Weather_PhotoImage"><Image resource="[COMPLICATION.PHOTO_IMAGE]"/></PartImage>
            </Complication>
            <Complication type="EMPTY"/>
        </ComplicationSlot>

        <!-- Row 2: Clock Display -->
        <Group name="clock_widget" x="0" y="145" width="450" height="120">
            <Launch target="ALARM"/>
            
            <!-- 24 HOUR FORMAT ([CONFIGURATION.clockFormat] == 0) -->
            <Group name="clock_24h_group" x="0" y="0" width="450" height="120">
                <Transform target="alpha" value="[CONFIGURATION.clockFormat] == 0 ? 255 : 0"/>
                
                <!-- Normal Weight -->
                <Group name="clock_24h_normal" x="0" y="0" width="450" height="120">
                    <Transform target="alpha" value="[CONFIGURATION.clockWeight] == 0 ? 255 : 0"/>
                    <DigitalClock x="0" y="0" width="450" height="120">
                        <TimeText format="hh:mm" hourFormat="24" x="0" y="0" width="450" height="120" align="CENTER">
                            <Font color="[CONFIGURATION.themeColor.2]" family="SYNC_TO_DEVICE" size="110" weight="NORMAL"/>
                        </TimeText>
                    </DigitalClock>
                </Group>
                
                <!-- Bold Weight -->
                <Group name="clock_24h_bold" x="0" y="0" width="450" height="120">
                    <Transform target="alpha" value="[CONFIGURATION.clockWeight] == 1 ? 255 : 0"/>
                    <DigitalClock x="0" y="0" width="450" height="120">
                        <TimeText format="hh:mm" hourFormat="24" x="0" y="0" width="450" height="120" align="CENTER">
                            <Font color="[CONFIGURATION.themeColor.2]" family="SYNC_TO_DEVICE" size="110" weight="BOLD"/>
                        </TimeText>
                    </DigitalClock>
                </Group>
                
                <!-- Light Weight -->
                <Group name="clock_24h_light" x="0" y="0" width="450" height="120">
                    <Transform target="alpha" value="[CONFIGURATION.clockWeight] == 2 ? 255 : 0"/>
                    <DigitalClock x="0" y="0" width="450" height="120">
                        <TimeText format="hh:mm" hourFormat="24" x="0" y="0" width="450" height="120" align="CENTER">
                            <Font color="[CONFIGURATION.themeColor.2]" family="SYNC_TO_DEVICE" size="110" weight="LIGHT"/>
                        </TimeText>
                    </DigitalClock>
                </Group>
            </Group>

            <!-- 12 HOUR FORMAT ([CONFIGURATION.clockFormat] == 1) -->
            <Group name="clock_12h_group" x="0" y="0" width="450" height="120">
                <Transform target="alpha" value="[CONFIGURATION.clockFormat] == 1 ? 255 : 0"/>
                
                <!-- Normal Weight -->
                <Group name="clock_12h_normal" x="0" y="0" width="450" height="120">
                    <Transform target="alpha" value="[CONFIGURATION.clockWeight] == 0 ? 255 : 0"/>
                    <DigitalClock x="0" y="0" width="450" height="120">
                        <TimeText format="hh:mm" hourFormat="12" x="0" y="0" width="450" height="120" align="CENTER">
                            <Font color="[CONFIGURATION.themeColor.2]" family="SYNC_TO_DEVICE" size="110" weight="NORMAL"/>
                        </TimeText>
                    </DigitalClock>
                </Group>
                
                <!-- Bold Weight -->
                <Group name="clock_12h_bold" x="0" y="0" width="450" height="120">
                    <Transform target="alpha" value="[CONFIGURATION.clockWeight] == 1 ? 255 : 0"/>
                    <DigitalClock x="0" y="0" width="450" height="120">
                        <TimeText format="hh:mm" hourFormat="12" x="0" y="0" width="450" height="120" align="CENTER">
                            <Font color="[CONFIGURATION.themeColor.2]" family="SYNC_TO_DEVICE" size="110" weight="BOLD"/>
                        </TimeText>
                    </DigitalClock>
                </Group>
                
                <!-- Light Weight -->
                <Group name="clock_12h_light" x="0" y="0" width="450" height="120">
                    <Transform target="alpha" value="[CONFIGURATION.clockWeight] == 2 ? 255 : 0"/>
                    <DigitalClock x="0" y="0" width="450" height="120">
                        <TimeText format="hh:mm" hourFormat="12" x="0" y="0" width="450" height="120" align="CENTER">
                            <Font color="[CONFIGURATION.themeColor.2]" family="SYNC_TO_DEVICE" size="110" weight="LIGHT"/>
                        </TimeText>
                    </DigitalClock>
                </Group>
            </Group>

            <!-- Seconds Display (Toggled by showSeconds) -->
            <Group name="seconds_group" x="380" y="15" width="70" height="40">
                <Transform target="alpha" value="[CONFIGURATION.showSeconds] ? 255 : 0"/>
                <Variant mode="AMBIENT" target="alpha" value="0"/>
                
                <!-- Normal Weight -->
                <Group name="seconds_normal" x="0" y="0" width="70" height="40">
                    <Transform target="alpha" value="[CONFIGURATION.clockWeight] == 0 ? 255 : 0"/>
                    <DigitalClock x="0" y="0" width="70" height="40">
                        <TimeText format="ss" x="0" y="0" width="70" height="40" align="START">
                            <Font color="[CONFIGURATION.themeColor.1]" family="SYNC_TO_DEVICE" size="26" weight="NORMAL"/>
                        </TimeText>
                    </DigitalClock>
                </Group>
                
                <!-- Bold Weight -->
                <Group name="seconds_bold" x="0" y="0" width="70" height="40">
                    <Transform target="alpha" value="[CONFIGURATION.clockWeight] == 1 ? 255 : 0"/>
                    <DigitalClock x="0" y="0" width="70" height="40">
                        <TimeText format="ss" x="0" y="0" width="70" height="40" align="START">
                            <Font color="[CONFIGURATION.themeColor.1]" family="SYNC_TO_DEVICE" size="26" weight="BOLD"/>
                        </TimeText>
                    </DigitalClock>
                </Group>
                
                <!-- Light Weight -->
                <Group name="seconds_light" x="0" y="0" width="70" height="40">
                    <Transform target="alpha" value="[CONFIGURATION.clockWeight] == 2 ? 255 : 0"/>
                    <DigitalClock x="0" y="0" width="70" height="40">
                        <TimeText format="ss" x="0" y="0" width="70" height="40" align="START">
                            <Font color="[CONFIGURATION.themeColor.1]" family="SYNC_TO_DEVICE" size="26" weight="LIGHT"/>
                        </TimeText>
                    </DigitalClock>
                </Group>
            </Group>

            <!-- AM/PM Indicator (Shown only in 12-hour format, below seconds) -->
            <Group name="ampm_widget" x="380" y="65" width="70" height="40">
                <Transform target="alpha" value="[CONFIGURATION.clockFormat] == 1 ? 255 : 0"/>
                <Variant mode="AMBIENT" target="alpha" value="0"/>
                
                <!-- AM ([AMPM_STATE] == 0) -->
                <Group name="ampm_am_group" x="0" y="0" width="70" height="40">
                    <Transform target="alpha" value="[AMPM_STATE] == 0 ? 255 : 0"/>
                    <!-- Normal Weight -->
                    <Group name="ampm_am_normal" x="0" y="0" width="70" height="40">
                        <Transform target="alpha" value="[CONFIGURATION.clockWeight] == 0 ? 255 : 0"/>
                        <PartText x="0" y="0" width="70" height="40" name="ampm_am_text_normal">
                            <Text align="START">
                                <Font color="[CONFIGURATION.themeColor.1]" family="SYNC_TO_DEVICE" size="26" weight="NORMAL">AM</Font>
                            </Text>
                        </PartText>
                    </Group>
                    <!-- Bold Weight -->
                    <Group name="ampm_am_bold" x="0" y="0" width="70" height="40">
                        <Transform target="alpha" value="[CONFIGURATION.clockWeight] == 1 ? 255 : 0"/>
                        <PartText x="0" y="0" width="70" height="40" name="ampm_am_text_bold">
                            <Text align="START">
                                <Font color="[CONFIGURATION.themeColor.1]" family="SYNC_TO_DEVICE" size="26" weight="BOLD">AM</Font>
                            </Text>
                        </PartText>
                    </Group>
                    <!-- Light Weight -->
                    <Group name="ampm_am_light" x="0" y="0" width="70" height="40">
                        <Transform target="alpha" value="[CONFIGURATION.clockWeight] == 2 ? 255 : 0"/>
                        <PartText x="0" y="0" width="70" height="40" name="ampm_am_text_light">
                            <Text align="START">
                                <Font color="[CONFIGURATION.themeColor.1]" family="SYNC_TO_DEVICE" size="26" weight="LIGHT">AM</Font>
                            </Text>
                        </PartText>
                    </Group>
                </Group>

                <!-- PM ([AMPM_STATE] == 1) -->
                <Group name="ampm_pm_group" x="0" y="0" width="70" height="40">
                    <Transform target="alpha" value="[AMPM_STATE] == 1 ? 255 : 0"/>
                    <!-- Normal Weight -->
                    <Group name="ampm_pm_normal" x="0" y="0" width="70" height="40">
                        <Transform target="alpha" value="[CONFIGURATION.clockWeight] == 0 ? 255 : 0"/>
                        <PartText x="0" y="0" width="70" height="40" name="ampm_pm_text_normal">
                            <Text align="START">
                                <Font color="[CONFIGURATION.themeColor.1]" family="SYNC_TO_DEVICE" size="26" weight="NORMAL">PM</Font>
                            </Text>
                        </PartText>
                    </Group>
                    <!-- Bold Weight -->
                    <Group name="ampm_pm_bold" x="0" y="0" width="70" height="40">
                        <Transform target="alpha" value="[CONFIGURATION.clockWeight] == 1 ? 255 : 0"/>
                        <PartText x="0" y="0" width="70" height="40" name="ampm_pm_text_bold">
                            <Text align="START">
                                <Font color="[CONFIGURATION.themeColor.1]" family="SYNC_TO_DEVICE" size="26" weight="BOLD">PM</Font>
                            </Text>
                        </PartText>
                    </Group>
                    <!-- Light Weight -->
                    <Group name="ampm_pm_light" x="0" y="0" width="70" height="40">
                        <Transform target="alpha" value="[CONFIGURATION.clockWeight] == 2 ? 255 : 0"/>
                        <PartText x="0" y="0" width="70" height="40" name="ampm_pm_text_light">
                            <Text align="START">
                                <Font color="[CONFIGURATION.themeColor.1]" family="SYNC_TO_DEVICE" size="26" weight="LIGHT">PM</Font>
                            </Text>
                        </PartText>
                    </Group>
                </Group>
            </Group>
        </Group>

        <!-- Row 3: Next Day Event Complication -->
        <ComplicationSlot slotId="3" displayName="Next Event" isCustomizable="FALSE" supportedTypes="LONG_TEXT SHORT_TEXT SMALL_IMAGE MONOCHROMATIC_IMAGE PHOTO_IMAGE EMPTY" x="40" y="260" width="370" height="45" name="Slot3_NextEvent" alpha="255">
            <Variant mode="AMBIENT" target="alpha" value="0"/>
            <DefaultProviderPolicy defaultSystemProvider="NEXT_EVENT" defaultSystemProviderType="LONG_TEXT"/>
            <BoundingBox x="0" y="0" width="370" height="45"/>
            <Complication type="LONG_TEXT">
                <PartText x="0" y="0" width="370" height="18" name="Event_Long_Title">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="14" color="[CONFIGURATION.themeColor.1]" weight="NORMAL">
                            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TITLE]"/></Template>
                        </Font>
                    </Text>
                </PartText>
                <PartText x="0" y="18" width="370" height="27" name="Event_Long_Text">
                    <Text align="CENTER">
