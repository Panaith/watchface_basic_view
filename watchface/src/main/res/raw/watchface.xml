<WatchFace
    height="450"
    width="450">
    <Metadata
        key="CLOCK_TYPE"
        value="DIGITAL" />

    <UserConfigurations>
        <ColorConfiguration id="timeColor" displayName="time_color" defaultValue="0">
            <ColorOption id="0" displayName="color_white" colors="#ffffffff" />
            <ColorOption id="1" displayName="color_orange" colors="#ffff7f00" />
            <ColorOption id="2" displayName="color_blue" colors="#ff00aaff" />
            <ColorOption id="3" displayName="color_green" colors="#ffaaee00" />
        </ColorConfiguration>
    </UserConfigurations>

    <Scene>
            <!-- Top Battery Widget -->
        <Group name="battery_widget" x="125" y="25" width="200" height="50">
            <Launch target="battery" />
            <!-- Background Bar -->
            <PartDraw x="76" y="5" width="48" height="6">
                <Line startX="0" startY="3" endX="48" endY="3">
                    <Stroke color="#ff333333" thickness="6" cap="ROUND" />
                </Line>
            </PartDraw>
            <!-- Foreground Progress Bar -->
            <Group name="battery_progress" x="76" y="5" width="48" height="6" pivotX="0" pivotY="0.5">
                <Transform target="scaleX" value="[BATTERY_PERCENT] / 100" />
                <PartDraw x="0" y="0" width="48" height="6">
                    <Line startX="0" startY="3" endX="48" endY="3">
                        <Stroke color="#ffaaee00" thickness="6" cap="ROUND" />
                    </Line>
                </PartDraw>
            </Group>
            <!-- Battery Percentage -->
            <PartText x="0" y="15" width="200" height="35">
                <Text align="CENTER">
                    <Font family="SYNC_TO_DEVICE" size="20" color="#ffdddddd" weight="BOLD">
                        <Template>
                            <![CDATA[%s%%]]><Parameter expression="[BATTERY_PERCENT]" />
                        </Template>
                    </Font>
                </Text>
            </PartText>
        </Group>

        <!-- Row 1: Left Complication (Date) -->
        <ComplicationSlot slotId="1" supportedTypes="SHORT_TEXT SMALL_IMAGE MONOCHROMATIC_IMAGE PHOTO_IMAGE EMPTY" x="45" y="98" width="170" height="60">
            <DefaultProviderPolicy defaultSystemProvider="DAY_OF_WEEK_AND_DATE" defaultSystemProviderType="SHORT_TEXT" />
            <BoundingBox x="0" y="0" width="170" height="60" />
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="5" width="170" height="20">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="16" color="#ffaaaaaa" weight="NORMAL">
                            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TITLE]" /></Template>
                        </Font>
                    </Text>
                </PartText>
                <PartText x="0" y="25" width="170" height="35">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="26" color="#ffffffff" weight="BOLD">
                            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="SMALL_IMAGE">
                <PartImage x="64" y="9" width="42" height="42"><Image resource="[COMPLICATION.SMALL_IMAGE]" /></PartImage>
            </Complication>
            <Complication type="MONOCHROMATIC_IMAGE">
                <PartImage x="64" y="9" width="42" height="42" tintColor="#ffffffff"><Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" /></PartImage>
            </Complication>
            <Complication type="PHOTO_IMAGE">
                <PartImage x="64" y="9" width="42" height="42"><Image resource="[COMPLICATION.PHOTO_IMAGE]" /></PartImage>
            </Complication>
        </ComplicationSlot>

        <!-- Row 1: Right Complication (Weather) -->
        <ComplicationSlot slotId="2" supportedTypes="SHORT_TEXT SMALL_IMAGE MONOCHROMATIC_IMAGE PHOTO_IMAGE EMPTY" x="235" y="98" width="170" height="60">
            <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="SHORT_TEXT" />
            <BoundingBox x="0" y="0" width="170" height="60" />
            <Complication type="SHORT_TEXT">
                <PartImage x="73" y="5" width="24" height="24">
                    <Image resource="[COMPLICATION.ICON]" />
                </PartImage>
                <PartText x="0" y="25" width="170" height="35">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="26" color="#ffffffff" weight="BOLD">
                            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="SMALL_IMAGE">
                <PartImage x="64" y="9" width="42" height="42"><Image resource="[COMPLICATION.SMALL_IMAGE]" /></PartImage>
            </Complication>
            <Complication type="MONOCHROMATIC_IMAGE">
                <PartImage x="64" y="9" width="42" height="42" tintColor="#ffffffff"><Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" /></PartImage>
            </Complication>
            <Complication type="PHOTO_IMAGE">
                <PartImage x="64" y="9" width="42" height="42"><Image resource="[COMPLICATION.PHOTO_IMAGE]" /></PartImage>
            </Complication>
        </ComplicationSlot>

        <!-- Row 2: Clock Display -->
        <Group name="clock_widget" x="0" y="182" width="450" height="85">
            <Launch target="alarm" />
            <DigitalClock x="0" y="0" width="450" height="85">
                <!-- Interactive Mode -->
                <TimeText format="hh:mm" x="0" y="0" width="450" height="85" align="CENTER">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Font color="[CONFIGURATION.timeColor]" family="SYNC_TO_DEVICE" size="86" weight="BOLD" />
                </TimeText>
                <TimeText format="ss" x="350" y="10" width="70" height="40" align="START">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Font color="[CONFIGURATION.timeColor]" family="SYNC_TO_DEVICE" size="22" weight="BOLD" />
                </TimeText>
                <!-- Ambient Mode -->
                <TimeText format="hh:mm" alpha="0" x="0" y="0" width="450" height="85" align="CENTER">
                    <Variant mode="AMBIENT" target="alpha" value="255" />
                    <Font color="[CONFIGURATION.timeColor]" family="SYNC_TO_DEVICE" size="86" weight="BOLD" />
                </TimeText>
            </DigitalClock>
        </Group>

        <!-- Row 3: Next Day Event Complication -->
        <ComplicationSlot slotId="3" supportedTypes="LONG_TEXT SHORT_TEXT SMALL_IMAGE MONOCHROMATIC_IMAGE PHOTO_IMAGE EMPTY" x="40" y="282" width="370" height="45">
            <DefaultProviderPolicy defaultSystemProvider="NEXT_EVENT" defaultSystemProviderType="LONG_TEXT" />
            <BoundingBox x="0" y="0" width="370" height="45" />
            <Complication type="LONG_TEXT">
                <PartText x="0" y="0" width="370" height="18">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="14" color="#ffaaaaaa" weight="NORMAL">
                            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TITLE]" /></Template>
                        </Font>
                    </Text>
                </PartText>
                <PartText x="0" y="18" width="370" height="27">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="20" color="#ffffffff" weight="BOLD">
                            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="0" width="370" height="18">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="14" color="#ffaaaaaa" weight="NORMAL">
                            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TITLE]" /></Template>
                        </Font>
                    </Text>
                </PartText>
                <PartText x="0" y="18" width="370" height="27">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="20" color="#ffffffff" weight="BOLD">
                            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="SMALL_IMAGE">
                <PartImage x="164" y="1" width="42" height="42"><Image resource="[COMPLICATION.SMALL_IMAGE]" /></PartImage>
            </Complication>
            <Complication type="MONOCHROMATIC_IMAGE">
                <PartImage x="164" y="1" width="42" height="42" tintColor="#ffffffff"><Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" /></PartImage>
            </Complication>
            <Complication type="PHOTO_IMAGE">
                <PartImage x="164" y="1" width="42" height="42"><Image resource="[COMPLICATION.PHOTO_IMAGE]" /></PartImage>
            </Complication>
        </ComplicationSlot>

        <!-- Bottom: App Shortcuts (5 Complications) -->
        <ComplicationSlot slotId="4" supportedTypes="MONOCHROMATIC_IMAGE SMALL_IMAGE PHOTO_IMAGE EMPTY" x="88" y="342" width="42" height="42">
            <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="SMALL_IMAGE" />
            <BoundingOval x="0" y="0" width="42" height="42" />
            <Complication type="MONOCHROMATIC_IMAGE">
                <PartImage x="0" y="0" width="42" height="42" tintColor="#ffffffff"><Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" /></PartImage>
            </Complication>
            <Complication type="SMALL_IMAGE">
                <PartImage x="0" y="0" width="42" height="42"><Image resource="[COMPLICATION.SMALL_IMAGE]" /></PartImage>
            </Complication>
            <Complication type="PHOTO_IMAGE">
                <PartImage x="0" y="0" width="42" height="42"><Image resource="[COMPLICATION.PHOTO_IMAGE]" /></PartImage>
            </Complication>
        </ComplicationSlot>

        <ComplicationSlot slotId="5" supportedTypes="MONOCHROMATIC_IMAGE SMALL_IMAGE PHOTO_IMAGE EMPTY" x="146" y="342" width="42" height="42">
            <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="SMALL_IMAGE" />
            <BoundingOval x="0" y="0" width="42" height="42" />
            <Complication type="MONOCHROMATIC_IMAGE">
                <PartImage x="0" y="0" width="42" height="42" tintColor="#ffffffff"><Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" /></PartImage>
            </Complication>
            <Complication type="SMALL_IMAGE">
                <PartImage x="0" y="0" width="42" height="42"><Image resource="[COMPLICATION.SMALL_IMAGE]" /></PartImage>
            </Complication>
            <Complication type="PHOTO_IMAGE">
                <PartImage x="0" y="0" width="42" height="42"><Image resource="[COMPLICATION.PHOTO_IMAGE]" /></PartImage>
            </Complication>
        </ComplicationSlot>

        <ComplicationSlot slotId="6" supportedTypes="MONOCHROMATIC_IMAGE SMALL_IMAGE PHOTO_IMAGE EMPTY" x="204" y="342" width="42" height="42">
            <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="SMALL_IMAGE" />
            <BoundingOval x="0" y="0" width="42" height="42" />
            <Complication type="MONOCHROMATIC_IMAGE">
                <PartImage x="0" y="0" width="42" height="42" tintColor="#ffffffff"><Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" /></PartImage>
            </Complication>
            <Complication type="SMALL_IMAGE">
                <PartImage x="0" y="0" width="42" height="42"><Image resource="[COMPLICATION.SMALL_IMAGE]" /></PartImage>
            </Complication>
            <Complication type="PHOTO_IMAGE">
                <PartImage x="0" y="0" width="42" height="42"><Image resource="[COMPLICATION.PHOTO_IMAGE]" /></PartImage>
            </Complication>
        </ComplicationSlot>

        <ComplicationSlot slotId="7" supportedTypes="MONOCHROMATIC_IMAGE SMALL_IMAGE PHOTO_IMAGE EMPTY" x="262" y="342" width="42" height="42">
            <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="SMALL_IMAGE" />
            <BoundingOval x="0" y="0" width="42" height="42" />
            <Complication type="MONOCHROMATIC_IMAGE">
                <PartImage x="0" y="0" width="42" height="42" tintColor="#ffffffff"><Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" /></PartImage>
            </Complication>
            <Complication type="SMALL_IMAGE">
                <PartImage x="0" y="0" width="42" height="42"><Image resource="[COMPLICATION.SMALL_IMAGE]" /></PartImage>
            </Complication>
            <Complication type="PHOTO_IMAGE">
                <PartImage x="0" y="0" width="42" height="42"><Image resource="[COMPLICATION.PHOTO_IMAGE]" /></PartImage>
            </Complication>
        </ComplicationSlot>

        <ComplicationSlot slotId="8" supportedTypes="MONOCHROMATIC_IMAGE SMALL_IMAGE PHOTO_IMAGE EMPTY" x="320" y="342" width="42" height="42">
            <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="SMALL_IMAGE" />
            <BoundingOval x="0" y="0" width="42" height="42" />
            <Complication type="MONOCHROMATIC_IMAGE">
                <PartImage x="0" y="0" width="42" height="42" tintColor="#ffffffff"><Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" /></PartImage>
            </Complication>
            <Complication type="SMALL_IMAGE">
                <PartImage x="0" y="0" width="42" height="42"><Image resource="[COMPLICATION.SMALL_IMAGE]" /></PartImage>
            </Complication>
            <Complication type="PHOTO_IMAGE">
                <PartImage x="0" y="0" width="42" height="42"><Image resource="[COMPLICATION.PHOTO_IMAGE]" /></PartImage>
            </Complication>
        </ComplicationSlot>

        <!-- Custom Logo -->
        <Group name="logo_widget" x="0" y="400" width="450" height="35">
            <Launch target="contacts" />
            <PartText x="0" y="0" width="450" height="35">
                <Text align="CENTER">
                    <Font family="corinthia" size="28" color="#ffcccccc">PanSar</Font>
                </Text>
            </PartText>
        </Group>
    </Scene>
</WatchFace>